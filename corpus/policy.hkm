(hakem 1)
; Fact and value: `Ought` is a normative symbol.

(sig pol
  (fn act 0 empirical)       ; a particular activity
  (rel Harm 1 empirical)     ; causes harm
  (rel Ought 1 normative))  ; ought to be prevented

(theory WithNorm pol
  (ax fact (Harm act))
  (ax norm (all (imp (Harm v0) (Ought v0)))))

(verdict prevent WithNorm (Ought act)
  (impE (allE act (ax norm)) (ax fact))
  (model 1 (fn act 0) (rel Harm 1) (rel Ought 1))
  (alt (rel Ought 0)))
