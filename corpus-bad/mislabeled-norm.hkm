(hakem 1)
; BAD DOCUMENT: the value premise "Ought" is labelled empirical. With the facts fixed,
; no normative symbol is left to vary, so no policy verdict can be built (Hume).
(sig pol (fn act 0 empirical) (rel Harm 1 empirical) (rel Ought 1 empirical))
(theory WithNorm pol
  (ax fact (Harm act))
  (ax norm (all (imp (Harm v0) (Ought v0)))))
(verdict prevent WithNorm (Ought act)
  (impE (allE act (ax norm)) (ax fact))
  (model 1 (fn act 0) (rel Harm 1) (rel Ought 1))
  (alt (rel Ought 0)))
