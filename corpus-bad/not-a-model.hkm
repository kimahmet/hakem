(hakem 1)
; BAD DOCUMENT: the metaphor's counterexample is not a model of the target theory (the loan does not change deposits).
(sig phys (fn E 1 empirical) (rel Exch 2 definitional))
(theory Physics phys (ax cons (all (all (imp (Exch v0 v1) (= (E v0) (E v1)))))))
(sig bank (fn Dep 1 empirical) (rel Cr 2 definitional))
(theory Banking bank (ax crMoney (all (all (imp (Cr v0 v1) (not (= (Dep v0) (Dep v1))))))))
(morph dep phys bank (fn E (Dep p0)) (rel Exch (Cr p0 p1)))
(refute depositsMetaphor Physics Banking dep
  (all (all (imp (Exch v0 v1) (= (E v0) (E v1)))))
  (ax cons)
  (model 2 (fn Dep 0 0) (rel Cr 0 0 1 0)))
