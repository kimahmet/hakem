(hakem 1)
; BAD DOCUMENT: the lemma's proof uses the wrong axiom (the loan axiom in the transfer branch).
(sig bank (fn Net 1 empirical) (rel Tr 2 definitional) (rel Cr 2 definitional))
(theory Banking bank
  (ax trNet (all (all (imp (Tr v0 v1) (= (Net v0) (Net v1))))))
  (ax crNet (all (all (imp (Cr v0 v1) (= (Net v0) (Net v1)))))))
(lemma stepNet Banking
  (all (all (imp (or (Tr v0 v1) (Cr v0 v1)) (= (Net v0) (Net v1)))))
  (allI (allI (impI (or (Tr v0 v1) (Cr v0 v1))
    (orE (hyp 0)
      (impE (allE v1 (allE v0 (ax crNet))) (hyp 0))
      (impE (allE v1 (allE v0 (ax crNet))) (hyp 0)))))))
